APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

STATIC_ENABLED=true

# The Open Graph card behind every og:image is drawn by headless Chrome, so the
# machine serving the site needs the binary: `which chromium` on macOS,
# `chromium-browser` on Debian/Ubuntu. A relative name is resolved over PATH,
# which php-fpm does not always share with the shell — an absolute path is the
# safe answer. OG_IMAGE_DEBUG=true re-renders the card on every request instead
# of serving the cached image, which is what you want while restyling it.
CHROME_PATH=chromium
OG_IMAGE_DEBUG=false

# Widgets on /now. Every one of them hides itself when its credentials are
# missing, so none of these are required to boot the site.

# The latest push and the star count read without credentials. Two things do
# need a token: the contribution graph, which GitHub only answers over GraphQL
# and only then counts the private work; and the organizations whose
# membership is not public, which is where most of the packages live. Scopes
# `read:user` and `read:org` cover both. Only public repositories are ever
# read, with or without a token.
#
# Connect it from a shell like the others — `php artisan socials:connect
# github` — with an OAuth app. GITHUB_TOKEN is the way out if you would rather
# paste a personal access token; a connected account wins over it.
GITHUB_USERNAME=markvaneijk
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_TOKEN=

# Spotify, Strava and X are connected from a shell — `php artisan socials:connect
# spotify` — and the tokens it stores live in the `socials` cache store from
# there: its own store, so the `cache:clear` a deploy runs leaves them alone.
# Only set SOCIALS_STORE to move them, and never to the store CACHE_DRIVER
# names. `socials:status` says whether they still read; `socials:disconnect`
# drops them.
# The redirect URIs default to <APP_URL>/socials/<service>/callback; set them
# only when that is not the URI registered with the provider.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
STRAVA_ATHLETE_ID=

# The follower count reads through `users/me`, which answers on the free tier
# where a username lookup wants a paid one — so this is the OAuth 2.0 client
# from the developer portal, not the API key and secret beside it. The username
# only builds the link on the card.
X_USERNAME=markvaneijk
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Fallback for the listening widgets — an API key is enough, no OAuth.
LASTFM_USERNAME=
LASTFM_KEY=
LASTFM_SECRET=
